#############################################
# Lab 1C — Environment Variables (EXAMPLE)
# File: lab-2a.auto.tfvars.example
# NOTE: Copy to lab-2a.auto.tfvars and fill in your values.
#############################################

# --------------------
# Global / Naming
# --------------------
env_prefix = "lab-2a"
project    = "Armageddon"

region     = "ap-northeast-1"
account_id = "123456789012"

# Optional (only if your modules require it)
kms_key_arn = "arn:aws:kms:ap-northeast-1:123456789012:key/REPLACE_ME"

tags = {
  Lab     = "LAB-2C"
  Project = "Armageddon"
}

# --------------------
# Networking
# --------------------
vpc_cidr_block = "10.30.0.0/16"

public_subnet_cidr   = "10.30.1.0/24"
public_subnet_cidr_2 = "10.30.2.0/24"

private_subnet_cidr_1 = "10.30.11.0/24"
private_subnet_cidr_2 = "10.30.12.0/24"

avail_zone_1 = "ap-northeast-1a"
avail_zone_2 = "ap-northeast-1c"

rtb_public_cidr = "0.0.0.0/0"

# --------------------
# EC2
# --------------------
instance_type = "t3.micro"

# --------------------
# RDS
# --------------------
db_name       = "labdb"
rds_multi_az  = false

# --------------------
# Alerting / SNS (MANDATORY for Bonus Labs B–F)
# --------------------
# This email receives CloudWatch alarm notifications (requires confirmation link).
alert_email = "REPLACE_ME@example.com"

###############################################################################
# Bonus B — ALB + TLS + WAF + Observability
###############################################################################

# Base domain used for TLS + optional DNS record creation
domain_name   = "devlab405.click"
app_subdomain = "app"

# Application port on the EC2 instance (ALB target group forwards to this)
app_port = 80

# DNS management mode (Bonus C extends this; keep here so Bonus D copy is easy)
#   - route53_existing : Use an existing Route53 hosted zone (recommended)
#   - route53_managed  : Terraform creates a hosted zone (use only if you truly want Terraform to own it)
#   - external         : No Route53 resources; DNS validation must be done outside Terraform
dns_mode = "route53_existing"

# Only required when dns_mode = "route53_existing"
route53_hosted_zone_id = "ZXXXXXXXXXXXXX"

# ALB 5xx alarm tuning (SNS notifications go to the topic created in modules/cloudwatch)
alb_5xx_threshold          = 10
alb_5xx_period_seconds     = 300
alb_5xx_evaluation_periods = 1

# WAF logging knobs (Bonus E expands this; safe to include now)
waf_log_destination              = "cloudwatch"  # cloudwatch | s3 | firehose
waf_log_retention_days           = 14
enable_waf_sampled_requests_only = false
