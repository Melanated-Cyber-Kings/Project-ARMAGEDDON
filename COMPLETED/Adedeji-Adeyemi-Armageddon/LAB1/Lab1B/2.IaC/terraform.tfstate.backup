            "public_dns": "ec2-44-200-215-238.compute-1.amazonaws.com",
            "public_ip": "44.200.215.238",
            "region": "us-east-1",
            "root_block_device": [
              {
                "delete_on_termination": true,
                "device_name": "/dev/xvda",
                "encrypted": false,
                "iops": 3000,
                "kms_key_id": "",
