# Allow ACLs (required for CloudFront logging)
resource "aws_s3_bucket_ownership_controls" "cf_logs2" {
  bucket = aws_s3_bucket.cf_logs2.id
  provider = aws.use1

  rule {
    # Must NOT be BucketOwnerEnforced for logging
    object_ownership = "BucketOwnerPreferred"
  }
}

# Give CloudFront log delivery permissions via canned ACL
resource "aws_s3_bucket_acl" "cf_logs2" {
  bucket = aws_s3_bucket.cf_logs2.id
  provider = aws.use1

  acl    = "log-delivery-write"

  depends_on = [
    aws_s3_bucket_ownership_controls.cf_logs2
  ]
}