# }



# S3 bucket to store CloudFront logs
resource "aws_s3_bucket" "cf_logs2" {
  bucket = lower("my-cloudfront-logs-${var.project}-sao-paulo-${random_string.short_string.result}")  # must be globally unique
  provider = aws.use1


  tags = {
    Name = "${var.project}-sao-paulo-cloudfront-logs"
  }
}

#(Optional but recommended) Block public access to the logs bucket
resource "aws_s3_bucket_public_access_block" "cf_logs2" {
  bucket = aws_s3_bucket.cf_logs2.id
  provider = aws.use1

  block_public_acls       = true
  block_public_policy     = true
  ignore_public_acls      = true
  restrict_public_buckets = true
}


