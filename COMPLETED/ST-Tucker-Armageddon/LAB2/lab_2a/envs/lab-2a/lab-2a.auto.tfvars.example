#############################################
# LAB-2A — Environment Variables (Example)
#############################################

# --------------------
# Global / Naming
# --------------------
env_prefix = "<env_prefix>"

# LAB-2 uses us-east-1
region     = "us-east-1"
account_id = "<aws_account_id>"

# If you have a KMS key in us-east-1, set it here.
# If not, leave as empty string and the lab will use AWS-managed keys.
kms_key_arn = "<kms_key_arn_or_empty>"

tags = {
  Lab     = "LAB-2A"
  Project = "<project_name>"
}

# --------------------
# Networking
# --------------------
vpc_cidr_block = "<vpc_cidr>"

public_subnet_cidr   = "<public_subnet_1_cidr>"
public_subnet_cidr_2 = "<public_subnet_2_cidr>"

private_subnet_cidr_1 = "<private_subnet_1_cidr>"
private_subnet_cidr_2 = "<private_subnet_2_cidr>"

# us-east-1 AZs
avail_zone_1 = "us-east-1a"
avail_zone_2 = "us-east-1b"

rtb_public_cidr = "0.0.0.0/0"

# --------------------
# EC2
# --------------------
instance_type = "<instance_type>"

# --------------------
# RDS
# --------------------
db_name = "<db_name>"

# Lab default: multi-AZ off unless explicitly enabled
rds_multi_az = false

# DB port (kept explicit for downstream modules/validation)
db_port = 3306

# Provide DB credentials for initial provisioning + secret payload.
# Use strong values (do not commit real passwords in public repos).
db_username = "<db_username>"
db_password = "<db_password>"

# --------------------
# Alerting / SNS
# --------------------
alert_email = "<alert_email>"

# --------------------
# Secrets + Rotation (grading)
# --------------------
enable_rotation     = true
rotation_days       = 30
manage_secret_value = true

##############################################
# Project Name
##############################################
project = "<project_name>"

###############################################################################
# ALB + TLS + WAF + Observability (Bonus-B baseline leveraged by LAB-2A)
###############################################################################
domain_name   = "<domain_name>"
app_subdomain = "<app_subdomain>"

enable_route53  = true
route53_zone_id = "<route53_zone_id>"

app_port                   = 80
alb_5xx_threshold          = 10
alb_5xx_period_seconds     = 300
alb_5xx_evaluation_periods = 1
