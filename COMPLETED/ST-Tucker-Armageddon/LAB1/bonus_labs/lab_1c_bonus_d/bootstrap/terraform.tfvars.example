# ============================================================
# Project: Armageddon — AWS Terraform Labs
# Lab:     1B
# Scope:   LAB1/b/bootstrap
# File:    terraform.tfvars.example
# Purpose: Example input values for provisioning Terraform
#          remote-state infrastructure (S3 + DynamoDB).
#
# Instructions:
# 1) Copy this file to terraform.tfvars
# 2) Modify region and bucket name
# 3) Bucket names must be globally unique
# ============================================================

##############################################
# AWS Region
##############################################

region = "us-east-1"

##############################################
# Terraform State Bucket
# MUST be globally unique across AWS.
##############################################

tf_state_bucket_name = "example-armageddon-lab1b-tfstate"

##############################################
# DynamoDB Lock Table
##############################################

tf_lock_table_name = "terraform-state-locks"

##############################################
# Organizational / Project Tags
##############################################

tags = {
  Project        = "Armageddon"
  Lab            = "1B"
  Environment    = "training"
  Owner          = "user"
  CostCenter     = "education"
  ManagedBy      = "terraform"
  Repository     = "armageddon-lab1b"
  Classification = "public"
}
