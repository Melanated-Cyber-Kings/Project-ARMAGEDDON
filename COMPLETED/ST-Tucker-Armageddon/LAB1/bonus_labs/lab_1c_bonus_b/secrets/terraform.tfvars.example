# ============================================================
# Project: Armageddon — AWS Terraform Labs
# Lab:     1B
# Stack:   secrets
# File:    terraform.tfvars.example
#
# Purpose:
#   Inputs for provisioning the database secret and (optionally)
#   associating Secrets Manager rotation with a Lambda function.
#
# Notes:
#   - MySQL default port is 3306
#   - PostgreSQL default port is 5432
#
# Rotation:
#   - Rotation is OPTIONAL and default OFF.
#   - To enable rotation, set:
#       rotation_lambda_account_id = "<your account id>"
#       rotation_lambda_name       = "<lambda function name>"
#     and keep rotation_days set as desired.
# ============================================================

##############################################
# Region / Naming
##############################################

region     = "ap-northeast-1"
env_prefix = "lab-1c"

##############################################
# Database credentials (stored in Secrets Manager)
##############################################

username = "admin"
password = "StrongPassword123!"

##############################################
# Database connection settings
# - MySQL/MariaDB: port 3306
# - PostgreSQL:    port 5432
##############################################

address = "REPLACE_WITH_RDS_ENDPOINT"
port    = 3306
dbname  = "appdb"

##############################################
# Rotation OPTIONAL (default OFF)
#
# Enable rotation by setting both:
#   rotation_lambda_account_id = "<ACCOUNT_ID>"
#   rotation_lambda_name       = "<FUNCTION_NAME>"
#
# To get your account id:
#   aws sts get-caller-identity --query Account --output text
##############################################

rotation_lambda_account_id = null
rotation_lambda_name       = null
enable_rotation = false
rotation_days              = 30

##############################################
# Secret value management
#
# If importing an existing secret and you want Terraform to
# preserve the current SecretString, set manage_secret_value=false.
##############################################

manage_secret_value = true

##############################################
# Tags
##############################################

tags = {
  Owner = "lab-1c"
}
