# ============================================================
# LAB1A — Student Configuration (EXAMPLE)
# ============================================================
# Copy to:
#   cp student.env.example student.env
#
# This file is ignored by git.
# ============================================================

AWS_PROFILE="lab-student"
AWS_SDK_LOAD_CONFIG=1

AWS_REGION="ap-northeast-1"
AWS_DEFAULT_REGION="ap-northeast-1"

TF_VAR_region="ap-northeast-1"

TF_VAR_account_id="123456789012"
TF_VAR_project="Armageddon"
TF_VAR_env_prefix="lab-1a"

TF_VAR_vpc_cidr_block="172.17.0.0/16"
TF_VAR_public_subnet_cidr="172.17.1.0/24"
TF_VAR_private_subnet_cidr_1="172.17.11.0/24"
TF_VAR_private_subnet_cidr_2="172.17.12.0/24"

TF_VAR_avail_zone_1="ap-northeast-1a"
TF_VAR_avail_zone_2="ap-northeast-1c"

TF_VAR_rtb_public_cidr="0.0.0.0/0"

TF_VAR_instance_type="t3.micro"

TF_VAR_secret_name="lab-1a/rds/mysql"
TF_VAR_rds_username="admin"
TF_VAR_rds_password="ChangeMe123!"

TF_VAR_db_name="labdb"
TF_VAR_port=3306
TF_VAR_address="pending"

TF_VAR_kms_key_arn="arn:aws:kms:ap-northeast-1:123456789012:key/abcd1234-5678-90ab-cdef-111111111111"

TF_VAR_rotation_lambda_arn=""

TF_VAR_enable_ssh="true"
TF_VAR_ssh_key_name="lab1a-student"
TF_VAR_ssh_private_key_file="./keys/lab1a-student.pem"
TF_VAR_ssh_ingress_cidr=""

TF_VAR_key_name="lab1a-student"
