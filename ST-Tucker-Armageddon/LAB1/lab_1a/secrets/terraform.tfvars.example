# ============================================================
# LAB1A — Secrets Bootstrap (EXAMPLE)
# ============================================================
# Copy to:
#   terraform.tfvars
#
# This file is NOT committed.
# ============================================================

region     = "ap-northeast-1"
account_id = "123456789012"

# Name of the secret EC2 will read later
secret_name = "lab-1a/rds/mysql"

# Initial DB values.
# Host/address will be updated AFTER RDS is created.
rds_username = "admin"
rds_password = "CHANGE_ME"

db_name = "labdb"
port    = 3306

# Placeholder until RDS exists
address = "pending"

# KMS key used to encrypt the secret (optional).
# Leave blank to let AWS use the default Secrets Manager key.
kms_key_arn = ""

# Optional: rotation lambda ARN
rotation_lambda_arn = ""
